PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
# Replace with your actual database URL
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local PostgreSQL: postgresql://postgres:password@localhost:5432/personal_diary
DATABASE_URL="postgresql://postgres:password@localhost:5432/personal_diary"

# Session Secret - Change this to a secure random string in production
SESSION_SECRET=your-secret-key-change-this-in-production

# Google OAuth (Get these from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Internal API Key for service-to-service authentication
# Use a strong, random string. Must match the key in background-service/.env
INTERNAL_API_KEY=your-strong-random-secret-key-here

# AWS S3 Configuration for media uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=your-s3-bucket-name

# CloudFront domain for serving media files (RECOMMENDED)
CLOUDFRONT_DOMAIN=d3g4so3tol1mjo.cloudfront.net

# Optional: Presigned URL expiration in seconds (default: 300 = 5 minutes)
# PRESIGNED_URL_EXPIRATION=300

# Optional: Maximum file size in bytes (default: 10485760 = 10MB)
# MAX_FILE_SIZE=10485760
