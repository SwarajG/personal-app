// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  password       String?          // Null for Google OAuth users
  name           String?
  googleId       String?          @unique
  avatar         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          Post[]
  monthlySummaries MonthlySummary[]
  people         Person[]         // People added by this user
  addedByUsers   Person[]         @relation("AddedPerson")

  @@index([email])
  @@index([googleId])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  date      DateTime
  mood      String?
  tags      String[] @default([])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
}

model MonthlySummary {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  summary     String   @db.Text
  generatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([year, month])
}

model Person {
  id          String   @id @default(cuid())
  userId      String   // The user who added this person
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedUserId String   // The user who was added to the people list
  addedUser   User     @relation("AddedPerson", fields: [addedUserId], references: [id], onDelete: Cascade)
  alias       String   // The alias/nickname for this person
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, addedUserId])
  @@index([userId])
  @@index([addedUserId])
}
